/*
 * XIAO nRF54LM20B Matter configuration with the external PY25Q128HA.
 */

/ {
	chosen {
		nordic,pm-ext-flash = &py25q128;
	};

	aliases {
		watchdog0 = &wdt31;
	};
};

&rram_controller {
	cpuapp_rram: rram@0 {
		reg = <0x0 DT_SIZE_K(2036)>;
		ranges = <0x0 0x0 DT_SIZE_K(2036)>;
	};
};

&py25q128 {
	status = "okay";
};

&wdt31 {
	status = "okay";
};

/*
 * Generated by CMake (see zephyr/CMakeLists.txt, "mdk-compat" section).
 * ----------------------------------------------------------------------------
 * The build defines both NRF54LM20A_XXAA and NRF54LM20B_XXAA and <mdk/nrf.h>
 * tests the LM20A variant first, so the Edge AI runtime's platform file
 * (which needs the LM20B-only AXONS NPU definitions) does not compile.
 *
 * This wrapper selects the LM20B headers via mdk_lm20b_compat.h and then
 * compiles the original, unmodified sdk-edge-ai platform source. It is the
 * ONLY translation unit that sees the LM20B header world.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include "@CMAKE_CURRENT_SOURCE_DIR@/mdk_lm20b_compat.h"
#include "@EA_PLATFORM_FILE@"
